# Copy to .env and fill in what you have. Every key is optional:
# a missing key makes that stage fall back to a free/offline default.

# --- LLM that picks stories and writes the script. Provider is picked from whichever key is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# SHORTS_LLM_PROVIDER=openai      # openai | anthropic | none
# SHORTS_LLM_MODEL=gpt-5          # one model for every role; default: gpt-5 for openai, claude-opus-5 for anthropic
# Per-role models. With OpenAI and no SHORTS_LLM_MODEL: editor and writer gpt-6-sol, checker gpt-6-luna.
# SHORTS_EDITOR_MODEL=
# SHORTS_WRITER_MODEL=
# SHORTS_CHECKER_MODEL=
# Agent loops: the editor searches and gets its picks checked, the writer is checked by a critic.
SHORTS_AGENTS=on
SHORTS_MAX_REPAIRS=2
# Spend caps in dollars; past them the LLM stages use their no-key fallbacks.
SHORTS_BUDGET_USD=0.60
SHORTS_MONTHLY_BUDGET_USD=18

# --- Newsletter inbox (AgentMail). The inbox id is its email address.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=agentnews247@agentmail.to

# --- Reads the full article behind each picked story (Tavily)
TAVILY_API_KEY=

# --- News sources: comma-separated list of: newsletter, rss, hackernews, reddit, sample
SHORTS_SOURCES=newsletter,rss,hackernews,reddit
# Optional override of the RSS feed list (comma-separated URLs)
SHORTS_RSS_FEEDS=
SHORTS_STORIES_PER_VIDEO=8
SHORTS_MAX_AGE_HOURS=30

# --- The show
SHORTS_SHOW_NAME=Duck Desk
SHORTS_HOST_NAME=Quackers
SHORTS_ANIMATOR=puppet

# --- Voice: edge (free Microsoft neural voices, no key) or silent
SHORTS_VOICE=edge
SHORTS_EDGE_VOICE=en-US-AnaNeural
SHORTS_EDGE_RATE=+8%

# --- Upload: local (just writes metadata) or youtube
SHORTS_UPLOADER=local
SHORTS_YOUTUBE_PRIVACY=private
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Where the "episode ready" / "run failed" email goes (sent from the AgentMail inbox)
SHORTS_NOTIFY_EMAIL=

SHORTS_X264_PRESET=medium
SHORTS_OUTPUT_DIR=output
SHORTS_STATE_DIR=state
